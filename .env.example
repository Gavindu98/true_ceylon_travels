# Copy to .env.local and fill in values from Supabase → Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only. Never expose to the browser or commit. Rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Analytics 4 measurement ID (Admin → Data Streams → Web)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P2E7CN6ENQ
